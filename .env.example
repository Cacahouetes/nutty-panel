# Environment Variables for Nutty Panel
# install.sh generates this file automatically with fresh secrets.

# Authentication / security
JWT_SECRET=change-me-with-openssl-rand-base64-32

# Initial admin (bootstrapped on first start when no user exists)
PANEL_ADMIN_EMAIL=admin@nutty.panel
PANEL_ADMIN_PASSWORD=change-me

# Public domain for automatic HTTPS via Caddy (Let's Encrypt)
# Leave empty for plain HTTP on port 80.
PANEL_DOMAIN=

# Docker socket used by the API to orchestrate Minecraft servers
DOCKER_HOST=unix:///var/run/docker.sock

# Optional: CurseForge / Modrinth integrations
CURSEFORGE_API_KEY=

# Optional: Playit.gg tunnels
PLAYIT_API_KEY=