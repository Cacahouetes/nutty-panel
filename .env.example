# Environment Variables for Nutty Panel
# Copy to .env and fill in your values

# Database
DATABASE_URL=file:./data/nutty-panel.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/nutty_panel

# Panel Configuration
PANEL_PORT=3000
PANEL_URL=http://localhost:3000
PANEL_ADMIN_PASSWORD=changeme-in-production

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=changeme-in-production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# Optional: Playit.gg
PLAYIT_API_KEY=

# Optional: CurseForge
CURSEFORGE_API_KEY=

# Optional: Modrinth
MODRINTH_API_TOKEN=
